# Setup-only product by default. No budget or commercial values are supplied.
PORT=4173
HOST=127.0.0.1
SHOP_DATA_DIR=.runtime/company-workspace
# Direct loopback browser access opens automatically; no token entry in the UI.
SHOP_LOCAL_OWNER_ACCESS=true
# Optional protected owner bearer for API clients/remote access; grants no spending.
SHOP_OWNER_TOKEN=
# Public URLs supplied as facts; Rules still bounds retrieval and assesses evidence.
SHOP_SOURCE_URLS=
# npm run dev starts an isolated local JBrain automatically from this binary.
# Build the pinned dependency with: npm run setup:jbrain
# SHOP_JBRAIN_BINARY=.runtime/dependencies/jbrain/target/release/jbrain
# Optional custom storage; default: $SHOP_DATA_DIR/company-brain
# SHOP_JBRAIN_DATA_DIR=/absolute/path/to/company-brain
# To use an existing service instead of starting one, configure its URL/token:
# SHOP_JBRAIN_URL=http://127.0.0.1:7331
# SHOP_JBRAIN_TOKEN_FILE=/private/path/to/token
# SHOP_JBRAIN_TOKEN=  # Prefer a private token file; never expose this in the browser.
# This ID binds the journal permanently; use a different store for another company.
SHOP_COMPANY_ID=local-workspace

# Optional live composition. Keep historical fixture and commercial stores separate.
# SHOP_CONFIG_PATH=/private/path/owner-rules.yaml
# SHOP_AUTHORIZATION_FILE=/private/path/authorization.json  # chmod 600
# SHOP_INFERENCE_BOUNDS_FILE=/private/path/inference-bounds.json
# NEAR_AI_API_KEY=
# NEAR_INTENTS_AGENT_API_KEY=
# NEAR_AGENT_GRANT_TOKEN=
# Optional label for newly created agents; existing agent IDs and grants are retained.
# COMPANYOS_EXTERNAL_USER_ID=companyos
# NEAR_AGENT_ID=
# NEAR_AGENT_ACCOUNT_ID=
# SHOP_SLIPPAGE_BPS=50
# See docs/BUSINESS_OPERATION.md. No account or grant is created automatically.
# Explicit current Agent API balance contract; no public-balance fallback.
# SHOP_AGENT_BALANCE_SOURCE=confidential
# SHOP_PAYMENTS_SECRET_REF=NEAR_1CLICK_API_KEY
# SHOP_PAYMENTS_AUTH_SCHEME=api-key  # or bearer, only after contract verification
# NEAR_1CLICK_API_KEY=

# Optional mentor integration components. Names refer to protected credentials.
# No action is enabled by these bindings; M01 also requires an exact policy,
# one-shot authorization, provider bounds and attributable resources/proofs.
# SHOP_INTEGRATION_AUTHORIZATION_FILE=/private/path/integration.authorization.json
# SHOP_LEDGER_AUTHORIZATION_FILE=/private/path/ledger.authorization.json
# OUTLAYER_PAYMENT_KEY=
# SHOP_OUTLAYER_PROJECT_OWNER=
# SHOP_OUTLAYER_PROJECT_NAME=
# SHOP_OUTLAYER_VERSION_HASH=  # exact SHA-256 of reviewed deployed evaluator
# SHOP_OUTLAYER_PAYMENT_KEY_OWNER=
# SHOP_OUTLAYER_PAYMENT_KEY_NONCE=
# SHOP_OUTLAYER_COMPUTE_MICRO_USD=1000
# SHOP_OUTLAYER_NETWORK=mainnet
# SHOP_OUTLAYER_VERIFIER_BINARY=  # optional absolute path; default is installed by scripts/setup-outlayer-verifier.mjs
# PING_API_KEY=
# See docs/MENTOR_IMPLEMENTATION.md. No public seller or account route is enabled.

# Optional private owner API bearer file (0600); local browser access needs no token.
# Disable automatic local access for shared/remote/proxied deployments:
# SHOP_LOCAL_OWNER_ACCESS=false
# SHOP_OWNER_TOKEN_FILE=/private/path/owner.token

# Owner-selected exact Cloud model for read-only attestation checks in setup.
# SHOP_COMPONENT_MODEL=  # Choose a currently supported NEAR TEE model explicitly.
# Paid one-shot component proof: private0600 manifest with exact request and caps.
# This does not authorize a company service or customer delivery.
# SHOP_COMPONENT_AUTHORIZATION_FILE=/private/path/component.authorization.json

# CompanyOs: separate private0600, work/request-scoped inference grant.
# Requires explicit config.autonomy ceilings, verified credit/bounds and proof.
# UI setup or an owner access token cannot create spending authority.
# SHOP_AGENT_AUTHORIZATION_FILE=/private/path/agent-work.authorization.json

# NEAR Cloud reporting: separate read-only token, NEVER the inference key.
# These organization reporting routes are deprecated by the provider. Disabled
# until the owner explicitly opts in to the documented legacy route; no new host
# or provider is selected automatically. Catalog reads need no token.
# SHOP_CLOUD_REPORTING_ORGANIZATION_ID=
# SHOP_CLOUD_REPORTING_SECRET_REF=NEAR_AI_REPORTING_TOKEN
# NEAR_AI_REPORTING_TOKEN=
# SHOP_CLOUD_LEGACY_REPORTING=false

# Optional lifetime USD-cost ceiling, in integer nanoUSD. USD5 =5000000000.
# This upper bound grants no model/credit/account/action and never resets by day.
# SHOP_TOTAL_CEILING_NANO_USD=5000000000

# Optional existing Cloud scope for OWNER-ONLY balance observations.
# The session token stays private; no token creation/login/provisioning is done.
# SHOP_CLOUD_CREDIT_ORGANIZATION_ID=
# SHOP_CLOUD_SESSION_SECRET_REF=NEAR_AI_USER_SESSION_TOKEN
# NEAR_AI_USER_SESSION_TOKEN=
# These reads cannot establish watermark, owner/key limits or additive credit.

# Company ledger: explicit chain binding, separate from custody/1Click swaps.
# Public observations/export/unsigned prepare grant no spending authority.
# User selected mainnet for this instance; no default network is assumed.
# SHOP_LEDGER_NETWORK=mainnet
# SHOP_LEDGER_CONTRACT_ID=
# SHOP_LEDGER_SIGNER_ID=  # actual company Agent API NEAR account, not deployment wallet
# SHOP_LEDGER_WALLET_PUBLIC_FILE=.runtime/company-ledger-wallet/mainnet/public.json
# Credential.json next to public.json is private0600; never expose it through HTTP.

# Agent buys NEAR AI Cloud credit with company-wallet USDC (scripts/demo-funded-loop.mjs buy-credits).
# NEAR AI Cloud has no purchase API: the agent pays USDC via NEAR Intents to a credit-holding
# organization, which transfers credit to the agent's own organization. One-time console setup:
# NEAR_CREDIT_SELLER_ORG_ID=         # org that HOLDS the credit to sell
# NEAR_CREDIT_SELLER_CREDENTIAL=     # SECRET: organization_credential (credits:transfer) for that org
# NEAR_CREDIT_RECIPIENT_ORG_ID=      # the AGENT's own org; its API key must be the one used for inference
# NEAR_CREDIT_SELLER_DESTINATION=    # seller Intents account that receives the USDC; add it to the agent policy destinations

# NanoGPT: inference provider whose API sells credit to the agent for native NEAR (scripts/demo-nanogpt-loop.mjs).
# Create a key at https://nano-gpt.com/api. Not TEE-attested; private verified inference stays on NEAR AI Cloud.
# NANOGPT_API_KEY=
# NANOGPT_MODEL=minimax/minimax-m2.7
